<?xml version="1.0" encoding="utf-8" ?>
<FactoryConfiguration>

	<!-- Pfade zu Template und Ausgabe -->
	<!-- Namensmuster: '*Template.dtsx'-->
	<TemplateFileName>../../../../MsSsisPackageFactoryTemplate/replicateDbTemplate.dtsx</TemplateFileName>
	<OutputDirectory>../../../../MsSsisPackageFactoryTemplate/GeneratedPackages</OutputDirectory>

	<!-- Datenbankverbindung -->
	<Database>
		<ConnectionString>
			Data Source=(localdb)\MSSQLLocalDB;Integrated Security=True;Initial Catalog=NorthWind;
			Connect Timeout=30;Encrypt=True;Trust Server Certificate=True;Application Intent=ReadWrite;
			Multi Subnet Failover=False
		</ConnectionString>
		<Schema>dbo</Schema>
	</Database>

	<!-- Auszuschließende Tabellen -->
	<ExcludedTables>
		<Table>dbo.CustomerCustomerDemo</Table>
		<Table>dbo.CustomerDemographics</Table>
		<Table>dbo.Employees</Table>
		<Table>dbo.EmployeeTerritories</Table>
		<Table>dbo.Order Details</Table>
		<Table>dbo.Orders</Table>
		<Table>dbo.Products</Table>
		<Table>dbo.Region</Table>
		<Table>dbo.Shippers</Table>
		<Table>dbo.Suppliers</Table>
		<Table>dbo.Territories</Table>
	</ExcludedTables>

	<!-- Anonymisierungsregeln -->
	<AnonymizationRules>
		<Rule>
			<TableName>dbo.Categories</TableName>
			<ColumnName>Description</ColumnName>
			<Method>Mask</Method>
		</Rule>
		<Rule>
			<TableName>dbo.Customers</TableName>
			<ColumnName>Region</ColumnName>
			<Method>Mask</Method>
		</Rule>
	</AnonymizationRules>
</FactoryConfiguration>