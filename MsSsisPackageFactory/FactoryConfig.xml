<?xml version="1.0" encoding="utf-8" ?>
<FactoryConfiguration>

	<!-- Pfade zu Template und Ausgabe -->
	<TemplateFileName>replicateDb.dtsx</TemplateFileName>
	<OutputDirectory>.\GeneratedPackages</OutputDirectory>

	<!-- Datenbankverbindung -->
	<Database>
		<ConnectionString>Server=.;Database=Northwind;Trusted_Connection=True;</ConnectionString>
		<Schema>dbo</Schema>
	</Database>

	<!-- Auszuschließende Tabellen -->
	<ExcludedTables>
		<Table>dbo.EmpLog</Table>
		<Table>dbo.SysDiagrams</Table>
	</ExcludedTables>

	<!-- Anonymisierungsregeln -->
	<AnonymizationRules>
		<Rule>
			<TableName>dbo.Customers</TableName>
			<ColumnName>Phone</ColumnName>
			<Method>Mask</Method>
		</Rule>
	</AnonymizationRules>
</FactoryConfiguration>