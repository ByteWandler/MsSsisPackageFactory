      <DTS:Variables />
      <DTS:LoggingOptions DTS:FilterKind="0" />
      <DTS:PropertyExpression DTS:Name="SqlStatementSource">"DECLARE @newDbName VARCHAR(max) = '" +  @[User::DestinationDbName] + "';" 
+
"\n"
+ "DECLARE @cmd VARCHAR(max) = 'CREATE DATABASE [' + @newDbName + '];';" 
+
"\n"
+ "EXEC (@cmd);"</DTS:PropertyExpression>
